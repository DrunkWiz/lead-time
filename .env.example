# Everything here is optional and free. With no keys at all, the app runs on its
# offline rules (labelled as such in the UI), so a demo never depends on a key.

# Order to try model providers; the offline rules are always the last resort.
LT_PROVIDER_CHAIN=soclaas,gemini

# Free for NUS students: SoCLaaS (OpenAI-compatible). BASE_URL is everything before /chat/completions.
# Models: llama3.1:8b (fastest), qwen3.5:9b (default), gemma4:26b, qwen3.8:27b (best quality, slower).
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=
SOCLAAS_MODEL=qwen3.5:9b

# Free: create a key at https://aistudio.google.com/apikey (no card needed for the free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional extra rung (add "featherless" to LT_PROVIDER_CHAIN to use it).
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Scripts only, free quota (10,000 units/day): Google Cloud console -> enable "YouTube Data API v3" -> API key.
YOUTUBE_API_KEY=
